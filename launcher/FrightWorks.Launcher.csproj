<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FrightWorks</AssemblyName>
    <RootNamespace>FrightWorks</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.1.1</Version>
    <Product>FrightWorks: Night of 100 Frights</Product>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>frightworks.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- The installer and updates (Velopack): keep in step with $VpkVersion in tools\package-scooby.ps1. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="art\mansion.png" LogicalName="FrightWorks.mansion.png" />
    <EmbeddedResource Include="art\mansion.json" LogicalName="FrightWorks.mansion.json" />
    <EmbeddedResource Include="art\dog.png" LogicalName="FrightWorks.dog.png" />
    <EmbeddedResource Include="art\ghost.png" LogicalName="FrightWorks.ghost.png" />
    <EmbeddedResource Include="fonts\LuckiestGuy-Regular.ttf" LogicalName="FrightWorks.LuckiestGuy-Regular.ttf" />
  </ItemGroup>
  <!-- The build ID (footer pill) goes in InformationalVersion: the game's own rules and text, from
       wiicompiled/runtime/cmake/build_info.cmake (release = clean checkout at tag v<Version>: just the version, else
       "<Version> branch@commit[+diff hash]"). Needs the portable CMake in toolchain\ (tools/build-no100f.ps1 installs
       it) or CMakeExe=<path>; without one the ID says so. -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CMakeExe Condition="'$(CMakeExe)' == ''">$(MSBuildThisFileDirectory)..\toolchain\CMake\bin\cmake.exe</CMakeExe>
  </PropertyGroup>
  <Target Name="FrightWorksBuildId" BeforeTargets="GetAssemblyVersion">
    <PropertyGroup>
      <_BuildIdRepo>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..').Replace('\', '/'))</_BuildIdRepo>
      <_BuildIdFile>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)build_id.txt</_BuildIdFile>
    </PropertyGroup>
    <Exec Condition="Exists('$(CMakeExe)')" StandardOutputImportance="low"
          Command="&quot;$(CMakeExe)&quot; &quot;-DREPO=$(_BuildIdRepo)&quot; &quot;-DOUT=$(_BuildIdFile.Replace('\', '/'))&quot; -P &quot;$(_BuildIdRepo)/wiicompiled/runtime/cmake/build_info.cmake&quot;" />
    <ReadLinesFromFile Condition="Exists('$(CMakeExe)')" File="$(_BuildIdFile)">
      <Output TaskParameter="Lines" PropertyName="_BuildId" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <InformationalVersion>$(_BuildId)</InformationalVersion>
      <InformationalVersion Condition="'$(_BuildId)' == ''">$(Version) (unknown build: no CMake)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
