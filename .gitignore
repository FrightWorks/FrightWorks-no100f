# FrightWorks: Night of 100 Frights - only sources, project files and scripts are tracked.
# Game data (the user's own disc) and everything built or downloaded stays out.
# The folders a worktree links to the main checkout (tools/debug/worktree.py) have no trailing slash: a rule ending
# in / matches only a real folder, and git sees a Linux symlink as a file, so the links would show as new files.
/Disc
/game
/toolchain
# Disc images, anywhere (people keep theirs at the repo root to build from).
*.iso
*.gcm
*.rvz
*.ciso
*.gcz
/autotest/
/build-logs/
/dist/
/_runtime_spm_backup/
/Play/*
!/Play/portable.txt
!/Play/Run with log.cmd

# wiicompiled build output, downloaded dependencies and translator binaries
/wiicompiled/generated/
/wiicompiled/native-build/
/wiicompiled/native-build-linux/
/wiicompiled/build/
/wiicompiled/Dependencies
/wiicompiled/translator/**/bin/
/wiicompiled/translator/**/obj/
/wiicompiled/Launcher/**/bin/
/wiicompiled/Launcher/**/obj/
/launcher/bin/
/launcher/obj/
/launcher/tests/bin/
/launcher/tests/obj/
/launcher/publish/
/tools/launcher-hdr-tests/bin/
/tools/launcher-hdr-tests/obj/
/tools/launcher-layout-tests/bin/
/tools/launcher-layout-tests/obj/
/tools/launcher-controller-tests/bin/
/tools/launcher-controller-tests/obj/
/tools/hip-patch-tests/bin/
/tools/hip-patch-tests/obj/

__pycache__/
*.pyc
wiicompiled/buildtools/artifacts/
*.log
*.log.out
texture_pack

# a person's own notes for development sessions, not part of the project (the shared ones are .agents/REPO.md)
AGENTS.md
/CLAUDE.md

# Claude Code's local folder, never tracked: tools/setup-agents.py links .claude/skills to the tracked .agents/skills
/.claude/
